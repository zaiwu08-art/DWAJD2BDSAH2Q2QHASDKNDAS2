-- ######################## CamLock (自动瞄准, 无需手动锁定) ########################
camLockTargetPlayer=nil
camLockActive=false
function unlockCamLock()
	camLockActive=false
	camLockTarget=nil
	camLockTargetPlayer=nil
	Camera.CameraType=Enum.CameraType.Custom
	Camera.CameraSubject=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
end
function applyCamLock(dt)
	if isSelfKnocked() then
		if camLockActive then unlockCamLock() end
		return
	end
	if not Config['CamLock'].Enabled then
		if camLockActive then unlockCamLock() end
		return
	end
	local m=UserInputService:GetMouseLocation()
	local closest=nil;local bd=math.huge
	for _,pl in ipairs(getValidTargetPlayers()) do
		local head=pl.Character and pl.Character:FindFirstChild('Head')
		if head then
			local sp,on=Camera:WorldToViewportPoint(head.Position)
			if on then
				local d=(Vector2.new(sp.X,sp.Y)-m).Magnitude
				if d<bd then bd=d closest=pl end
			end
		end
	end
	if not closest then
		if camLockActive then unlockCamLock() end
		return
	end
	camLockTarget=closest
	camLockTargetPlayer=closest
	local head=closest.Character:FindFirstChild('Head') or closest.Character:FindFirstChild('HumanoidRootPart')
	local myHRP=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
	if not head or not myHRP then return end
	camLockActive=true
	Camera.CameraType=Enum.CameraType.Scriptable
	local f=math.clamp((100-Config['CamLock'].Smoothness)/100,0,1)*math.clamp(dt*60,0,1)
	local camPos=myHRP.Position+Vector3.new(0,2.2,0)
	local lookVector=(head.Position-camPos).Unit
	local cc=Camera.CFrame
	local smoothedLook=cc.LookVector:Lerp(lookVector,f)
	Camera.CFrame=CFrame.new(camPos,camPos+smoothedLook)
end


