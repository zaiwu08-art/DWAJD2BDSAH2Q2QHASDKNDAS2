end
function smIsReloading(char,tool)
 if tool then
  local av=getToolAmmo(tool)
  if av and tonumber(av.Value)==0 then return true end
  local rl=tool:FindFirstChild('Reloading')
  if rl and rl.Value==true then return true end
 end
 local be=char and (char:FindFirstChild(GameCfg.folderName) or char:FindFirstChild('BodyEffects'))
 local r=be and be:FindFirstChild('Reload')
