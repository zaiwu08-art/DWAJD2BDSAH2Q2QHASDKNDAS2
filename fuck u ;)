			table.insert(data.sounds, snd);
			snd.Ended:Connect(function()
				snd:Destroy();
			end);
		end;
		data.conns = data.conns or {};
		local function StripKnifeIntruders()
			if KnifeData[Tool] ~= data then return end;
			if mesh and mesh.Parent then
				mesh.Transparency = 1;
				for _, v in next, mesh:GetChildren() do
					if (v:IsA('Model') or v:IsA('MeshPart')) and v.Name ~= SkinName then
						v:Destroy();
					end;
				end;
			end;
			for _, v in next, Tool:GetChildren() do
				if (v:IsA('Model') or v:IsA('MeshPart')) and v ~= mesh and v.Name ~= 'Handle' and v.Name ~= SkinName then
					v:Destroy();
				end;
			end;
		end;
		local kc1 = Tool.ChildAdded:Connect(function(c)
			if (c:IsA('Model') or c:IsA('MeshPart')) and c ~= mesh and c.Name ~= 'Handle' and c.Name ~= SkinName then
				task.defer(StripKnifeIntruders);
			end;
		end);
		table.insert(data.conns, kc1);
		if mesh then
			local kc2 = mesh.ChildAdded:Connect(function(c)
				if (c:IsA('Model') or c:IsA('MeshPart')) and c.Name ~= SkinName then
					task.defer(StripKnifeIntruders);
				end;
			end);
			table.insert(data.conns, kc2);
			local kc3 = mesh:GetPropertyChangedSignal('Transparency'):Connect(function()
				if KnifeData[Tool] == data and mesh.Transparency ~= 1 then
					mesh.Transparency = 1;
				end;
			end);
			table.insert(data.conns, kc3);
		end;
	end;

	local function LoadSkinData()
		if SkinData then return SkinData end;
		if SkinModules and typeof(SkinModules) == 'Instance' and SkinModules:IsA('ModuleScript') then
			local ok, result = pcall(require, SkinModules);
			if ok and type(result) == 'table' then SkinData = result; end;
		end;
		if not SkinData and shared.skin_modules and next(shared.skin_modules) then
			SkinData = shared.skin_modules;
		end;
		if SkinData then
			for Tool, SkinName in next, PendingSkinReprocess do
				if Tool and Tool.Parent and SkinName and SkinName ~= '' and SkinName ~= 'None' then
					task.defer(function()
						ToolRegistry[Tool] = nil;
						scxProcessTool(Tool);
					end);
				end;
				PendingSkinReprocess[Tool] = nil;
			end;
		end;
		return SkinData;
	end;

	local function HateSkinNormKey(s)
		return tostring(s or ''):lower():gsub('[%[%]_%s%-%.]','');
	end;

	local function GetSkinInfo(weaponName, skinName)
		local data = LoadSkinData();
		if not data then return nil end;
		local weaponSkins = data[weaponName];
		if not weaponSkins then
			local bracketName = '[' .. weaponName:gsub('%[', ''):gsub('%]', '') .. ']';
			weaponSkins = data[bracketName];
		end;
		if not weaponSkins then
			local want = HateSkinNormKey(weaponName);
			for key, val in next, data do
				if type(key) == 'string' and HateSkinNormKey(key) == want then weaponSkins = val; break; end;
			end;
		end;
		if not weaponSkins then return nil end;
		local info = weaponSkins[skinName];
		if not info then
			info = weaponSkins[skinName:gsub('-', ' ')];
		end;
		if not info then
			info = weaponSkins[skinName:gsub('-', '')];
		end;
		return info;
	end;

	local function FindSourceMesh(skinName, meshRef, isKnife)
		if not SkinModules or typeof(SkinModules) ~= 'Instance' then return nil end;
		if isKnife then
			local cleanSkin = skinName:lower():gsub(' ', '');
			local KnivesFolder = SkinModules:FindFirstChild('Knives');
			if KnivesFolder then
				for _, child in next, KnivesFolder:GetChildren() do
					if child:IsA('MeshPart') then
						local cleanName = child.Name:lower():gsub(' ', '');
						if child.Name == skinName or cleanName == cleanSkin then
							return child;
						end;
					elseif child:IsA('Folder') or child:IsA('Model') then
						local cleanName = child.Name:lower():gsub(' ', '');
						if child.Name == skinName or cleanName == cleanSkin then
							for _, sub in next, child:GetChildren() do
								if sub:IsA('MeshPart') then
									return sub;
								end;
							end;
						end;
					end;
				end;
			end;
			if SkinAssets then
				local KnifeFolder = SkinAssets:FindFirstChild('KnifeMeshes') or SkinAssets:FindFirstChild('Knives');
				if KnifeFolder then
					for _, child in next, KnifeFolder:GetChildren() do
						if child:IsA('MeshPart') then
							local cleanName = child.Name:lower():gsub(' ', '');
							if child.Name == skinName or cleanName == cleanSkin then
								return child;
							end;
						elseif child:IsA('Folder') or child:IsA('Model') then
							local cleanName = child.Name:lower():gsub(' ', '');
							if child.Name == skinName or cleanName == cleanSkin then
								for _, sub in next, child:GetChildren() do
									if sub:IsA('MeshPart') then
										return sub;
									end;
								end;
							end;
						end;
					end;
				end;
			end;
			return nil;
		end;
		local MeshesFolder = SkinModules:FindFirstChild('Meshes');
		if not MeshesFolder then return nil end;
		local folderNames = { skinName, skinName:gsub(' ', ''), skinName:gsub(' ', '_') };
		for _, folderName in next, folderNames do
			local skinFolder = MeshesFolder:FindFirstChild(folderName);
			if skinFolder then
				if meshRef then
					for _, child in next, skinFolder:GetChildren() do
						if child:IsA('MeshPart') then
							local cleanChild = child.Name:lower():gsub(' ', ''):gsub('-', '');
							local cleanRef = meshRef:lower():gsub(' ', ''):gsub('-', '');
							if child.Name == meshRef or cleanChild == cleanRef then
								return child;
							end;
						end;
					end;
				end;
				for _, child in next, skinFolder:GetChildren() do
					if child:IsA('MeshPart') then
						return child;
					end;
				end;
			end;
		end;
		if SkinAssets then
			local GunMeshes = SkinAssets:FindFirstChild('GunMeshes');
			if GunMeshes then
				for _, folderName in next, folderNames do
					local skinFolder = GunMeshes:FindFirstChild(folderName);
					if skinFolder then
						for _, child in next, skinFolder:GetChildren() do
							if child:IsA('MeshPart') then
								return child;
							end;
						end;
					end;
				end;
			end;
		end;
		return nil;
	end;

	ShootSoundDefaults = setmetatable({}, {__mode='k'});
	HateKnifeSourceModel = function(Tool, skinName)
		local function Unwrap(node)
			if not node or typeof(node) ~= 'Instance' then return nil end;
			if node:IsA('MeshPart') or node:IsA('BasePart') then return node end;
			if node:IsA('Model') then
				for _, p in next, node:GetDescendants() do
					if p:IsA('BasePart') then return node end;
				end;
				return nil;
			end;
			if node:IsA('Folder') then
				for _, p in next, node:GetDescendants() do
					if p:IsA('MeshPart') then return p end;
				end;
			end;
			return nil;
		end;
		local tname = (Tool and Tool.Name) or '[Knife]';
		local info = GetSkinInfo('[Knife]', skinName) or GetSkinInfo('Knife', skinName) or GetSkinInfo(tname, skinName);
		if type(info) == 'table' then
			local hit = Unwrap(info.TextureID) or Unwrap(info.Mesh) or Unwrap(info.Model) or Unwrap(info.Skin);
			if hit then return hit end;
			for _, v in next, info do
				local unw = Unwrap(v);
				if unw then return unw end;
			end;
			for _, v in next, info do
				if type(v) == 'table' then
					for _, v2 in next, v do
						local unw = Unwrap(v2);
						if unw then return unw end;
					end;
				end;
			end;
		end;
		local found = FindSourceMesh(skinName, nil, true);
		if found then return found end;
		local want = HateSkinNormKey(skinName);
		if SkinAssets then
			for _, top in next, SkinAssets:GetChildren() do
				local ln = top.Name:lower();
				if (ln:find('knife') or ln:find('knives') or ln:find('blade')) then
                    local hit = top:FindFirstChild(skinName)
                     or top:FindFirstChild(tostring(skinName):gsub('-', ' '))
                     or top:FindFirstChild(tostring(skinName):gsub('-', ''));
                    hit = Unwrap(hit);
                    if hit then return hit end;
                    for _, c in next, top:GetChildren() do
                       if HateSkinNormKey(c.Name) == want then
                        local unw = Unwrap(c);
                        if unw then return unw end;
                       end;
                    end;
				end;
			end;
		end;
		return nil;
	end;
	HateKnifeSkinParts = function(Tool, skinName)
		local out = {};
		local function take(field, value)
			if value == nil then return end;
			local f = tostring(field or ''):lower();
			local kind = nil;
			if f:find('anim') then
				if f:find('attack') or f:find('slash') or f:find('swing') or f:find('use') then kind = 'AttackAnim'; else kind = 'EquipAnim'; end;
			elseif f:find('sound') or f:find('sfx') or f:find('audio') then
				if f:find('attack') or f:find('slash') or f:find('swing') or f:find('use') or f:find('hit') then kind = 'AttackSound'; else kind = 'EquipSound'; end;
			elseif f:find('mesh') then kind = 'MeshId';
			elseif f:find('tex') then kind = 'TextureId';
			else return end;
			if out[kind] then return end;
			if typeof(value) == 'Instance' then
                    if value:IsA('Animation') then out[kind] = value.AnimationId;
                    elseif value:IsA('Sound') then out[kind] = value.SoundId;
                    elseif value:IsA('StringValue') then out[kind] = value.Value;
                    elseif value:IsA('MeshPart') and kind == 'MeshId' then out.MeshId = value.MeshId;
                    elseif value:IsA('BasePart') and kind == 'TextureId' then out.TextureId = value.TextureID;
                    end;
			elseif type(value) == 'string' and value ~= '' then out[kind] = value;
			elseif type(value) == 'number' and value > 1000 then out[kind] = 'rbxassetid://' .. value;
			end;
		end;
		local tname = (Tool and Tool.Name) or '[Knife]';
		local info = GetSkinInfo('[Knife]', skinName) or GetSkinInfo('Knife', skinName) or GetSkinInfo(tname, skinName);
		if typeof(info) == 'Instance' then
			if info:IsA('MeshPart') then out.MeshPart = info;
			elseif info:IsA('Model') then out.Model = info; end;
		elseif type(info) == 'table' then
			for k, v in next, info do take(k, v) end;
			for k, v in next, info do
				if type(v) == 'table' then for k2, v2 in next, v do take(tostring(k) .. tostring(k2), v2) end; end;
			end;
			for _, v in next, info do
				if typeof(v) == 'Instance' then
                        if v:IsA('MeshPart') and not out.MeshPart then out.MeshPart = v;
                        elseif v:IsA('Model') and not out.Model then out.Model = v; end;
				end;
			end;
		end;
		if not out.MeshPart then out.MeshPart = HateKnifeSourceModel(Tool, skinName) end;
		return out;
	end;

	local function ApplyKnifeSkinLook(Tool, default, skinName)
		local parts = HateKnifeSkinParts(Tool, skinName);
		local data = AppliedSkins[Tool];
		if not data then return end;
		local src = parts.MeshPart;
		if (not src or not src:IsA('MeshPart')) then
			local node = HateKnifeSourceModel(Tool, skinName);
			if node and node:IsA('MeshPart') then src = node; end;
		end;
		local wantMesh = parts.MeshId;
		local wantTex = parts.TextureId;
		if src and src:IsA('MeshPart') then
			wantMesh = wantMesh or (src.MeshId ~= '' and src.MeshId) or nil;
			wantTex = wantTex or (src.TextureID ~= '' and src.TextureID) or nil;
		end;
		local changed = false;
		if wantMesh and wantMesh ~= '' and default.MeshId ~= wantMesh then
			pcall(function() default.MeshId = wantMesh end);
			data.DesiredMeshId = wantMesh;
			changed = true;
		end;
		if wantTex and wantTex ~= '' and default.TextureID ~= wantTex then
			pcall(function() default.TextureID = wantTex end);
			changed = true;
		end;
		if changed then
			data.DesiredTextureID = default.TextureID;
			data.DesiredTransparency = default.Transparency;
			data.HideDefault = false;
		end;
		if parts.EquipAnim and not data.KnifeEquipAnim then data.KnifeEquipAnim = { AnimationId = parts.EquipAnim }; end;
		if parts.AttackAnim and not data.KnifeAttackAnim then data.KnifeAttackAnim = { AnimationId = parts.AttackAnim }; end;
		if parts.EquipSound and not data.KnifeEquipSound then data.KnifeEquipSound = parts.EquipSound; end;
		if parts.AttackSound and not data.KnifeAttackSound then data.KnifeAttackSound = parts.AttackSound; end;
	end;


	local function HateSkinSoundFrom(node, skinName)
		if not node then return nil end;
		local function Read(inst)
			if not inst then return nil end;
			if inst:IsA('StringValue') and inst.Value ~= '' then return inst.Value end;
			if inst:IsA('Sound') and inst.SoundId ~= '' then return inst.SoundId end;
			for _, d in next, inst:GetDescendants() do
				if d:IsA('Sound') and d.SoundId ~= '' then return d.SoundId end;
				if d:IsA('StringValue') and d.Value ~= '' then return d.Value end;
			end;
			return nil;
		end;
		local got = Read(node:FindFirstChild(skinName));
		if got then return got end;
		local want = HateSkinNormKey(skinName);
		for _, child in next, node:GetChildren() do
			if HateSkinNormKey(child.Name) == want then
				got = Read(child);
				if got then return got end;
			end;
		end;
		return nil;
	end;

	local function GetShootSound(weaponName, skinName)
		local want = HateSkinNormKey(weaponName);
		local folders = {};
		if SkinAssets then
			local GunShootSounds = SkinAssets:FindFirstChild('GunShootSounds');
			if GunShootSounds then
				folders[#folders + 1] = GunShootSounds:FindFirstChild(weaponName);
				folders[#folders + 1] = GunShootSounds:FindFirstChild(tostring(weaponName):gsub('%[', ''):gsub('%]', ''));
			for _, c in next, GunShootSounds:GetChildren() do
				if HateSkinNormKey(c.Name) == want then folders[#folders + 1] = c; break; end;
			end;
			end;
			for _, top in next, SkinAssets:GetChildren() do
				local ln = top.Name:lower();
				if top:IsA('Folder') and top ~= GunShootSounds and (ln:find('sound') or ln:find('shoot')) then
				for _, c in next, top:GetChildren() do
                    if HateSkinNormKey(c.Name) == want then folders[#folders + 1] = c; break; end;
				end;
				end;
			end;
		end;
		for _, folder in next, folders do
			local got = HateSkinSoundFrom(folder, skinName);
			if got then return got end;
		end;
		local info = GetSkinInfo(weaponName, skinName);
		if type(info) == 'table' then
			for _, key in next, { 'ShootSound', 'Sound', 'SoundId', 'FireSound', 'ShootSoundId' } do
				local v = info[key];
				if type(v) == 'string' and v ~= '' then return v end;
				if typeof(v) == 'Instance' then
                    if v:IsA('Sound') and v.SoundId ~= '' then return v.SoundId end;
                    if v:IsA('StringValue') and v.Value ~= '' then return v.Value end;
				end;
			end;
		end;
		return nil;
	end;

	local ApplySkinToTool;
	local RemoveSkinFromTool;

	local function FindShootSoundInstance(Tool)
		if not Tool then return nil end;
		for _, child in next, Tool:GetDescendants() do
			if child:IsA('Sound') and (child.Name == 'Shoot' or child.Name == 'ShootSound') then
				return child;
			end;
		end;
		return nil;
	end;

	local function BindShootSoundForSkin(Tool)
		local skinData = AppliedSkins[Tool];
		if not skinData then return end;
		if not skinData.ShootSoundOriginals then
			skinData.ShootSoundOriginals = {};
		end;
		local found = {};
		for _, child in next, Tool:GetDescendants() do
			if child:IsA('Sound') and (child.Name == 'Shoot' or child.Name == 'ShootSound') then
				found[#found + 1] = child;
			end;
		end;
		if #found == 0 then return end;
		local soundId = GetShootSound(Tool.Name, skinData.SkinName);
		skinData.DesiredShootSoundId = (soundId and soundId ~= '') and soundId or nil;
		for _, shootSound in next, found do
			if ShootSoundDefaults[shootSound] == nil then
				ShootSoundDefaults[shootSound] = shootSound.SoundId;
			end;
			skinData.ShootSoundOriginals[shootSound] = ShootSoundDefaults[shootSound];
			skinData.ShootSound = shootSound;
			local want = skinData.DesiredShootSoundId or tostring(ShootSoundDefaults[shootSound] or '');
			if shootSound.SoundId ~= want then shootSound.SoundId = want end;
		end;
		if not skinData.ShootSoundGuarded then
			skinData.ShootSoundGuarded = true;
			for _, shootSound in next, found do
				local cn = shootSound:GetPropertyChangedSignal('SoundId'):Connect(function()
                    if AppliedSkins[Tool] ~= skinData then return end;
                    local want = skinData.DesiredShootSoundId;
                    if want and shootSound.Parent and shootSound.SoundId ~= want then
                        shootSound.SoundId = want;
                    end;
				end);
				table.insert(skinData.Connections, cn);
			end;
		end;
	end;

	local function StripForeignGunMeshes(Tool, default, Handle)
		if not Tool or not default then return end;
		local function IsOurs(nm)
			return #nm == 0 or nm == '\0';
		end;
		for _, child in next, Tool:GetChildren() do
			if child:IsA('MeshPart') and child ~= default and child ~= Handle and not IsOurs(child.Name) then
				child:Destroy();
			end;
		end;
		for _, child in next, default:GetChildren() do
			if child:IsA('MeshPart') and not IsOurs(child.Name) then
				child:Destroy();
			end;
		end;
	end;

	local function ReapplyGunSkinState(Tool)
		local skinData = AppliedSkins[Tool];
		if not skinData then return end;
		local default = skinData.Default;
		if not default or not default.Parent then return end;
		local Handle = Tool and Tool:FindFirstChild('Handle');
		StripForeignGunMeshes(Tool, default, Handle);
		if skinData.HideDefault then
			if default.Transparency ~= 1 then
				default.Transparency = 1;
			end;
		else
			if skinData.DesiredTransparency ~= nil and default.Transparency ~= skinData.DesiredTransparency then
				default.Transparency = skinData.DesiredTransparency;
			end;
			if skinData.DesiredTextureID ~= nil and default.TextureID ~= skinData.DesiredTextureID then
				default.TextureID = skinData.DesiredTextureID;
			end;
		end;
	end;

	RemoveSkinFromTool = function(Tool)
		if not Tool or not AppliedSkins[Tool] then return end;
		CleanKnife(Tool);
		local original = AppliedSkins[Tool];
		if original.Connections then
			for _, connection in next, original.Connections do
				if connection and connection.Connected then
					connection:Disconnect();
				end;
			end;
		end;
		for _, child in next, original.ClonedChildren or {} do
			if child and child.Parent then
				child:Destroy();
			end;
		end;
		if original.Default and original.Default.Parent then
			for _, child in next, original.Default:GetChildren() do
				if child.Name == '\0' then
					child:Destroy();
				end;
			end;
			original.Default.Transparency = original.OriginalTransparency or 0;
			original.Default.TextureID = original.OriginalTextureID or '';
			if original.OriginalMeshId and original.OriginalMeshId ~= '' then
				pcall(function() original.Default.MeshId = original.OriginalMeshId end);
			end;
		end;
		for _, entry in next, original.HiddenParts or {} do
			if entry.part and entry.parent then
				pcall(function() entry.part.Parent = entry.parent end);
			end;
		end;
		if original.ShootSoundOriginals then
			for sound, soundId in next, original.ShootSoundOriginals do
				if sound and sound.Parent then
					sound.SoundId = tostring(soundId or ShootSoundDefaults[sound] or '');
				end;
			end;
		elseif original.ShootSound and original.OriginalShootSoundId then
			original.ShootSound.SoundId = original.OriginalShootSoundId;
		end;
		local Handle = Tool:FindFirstChild('Handle');
		if Handle then
			Handle:SetAttribute('SkinName', original.OriginalSkinName or '');
		end;
		AppliedSkins[Tool] = nil;
	end;

	local function ScheduleInitialGunRefresh(Tool, SkinName)
		if not Tool or InitialGunSkinRefreshDone[Tool] then return end;
		InitialGunSkinRefreshDone[Tool] = true;
		task.delay(0.35, function()
			local skinData = AppliedSkins[Tool];
			if not skinData or skinData.SkinName ~= SkinName then
				return;
			end;
			RemoveSkinFromTool(Tool);
			ApplySkinToTool(Tool, SkinName);
		end);
	end;

	ApplySkinToTool = function(Tool, SkinName)
		if not Tool then return end;
		if AppliedSkins[Tool] and AppliedSkins[Tool].SkinName == SkinName then return end;
		local Handle = Tool:FindFirstChild('Handle');
		if not Handle then return end;
		local default = Tool:FindFirstChild('Default');
		if not default or not default:IsA('MeshPart') then
			default = Handle:FindFirstChildOfClass('MeshPart');
			if not default then
				for _, child in next, Tool:GetDescendants() do
					if child:IsA('MeshPart') then
						default = child;
						break;
					end;
				end;
			end;
		end;
		if not default then return end;
		local ShootSound = FindShootSoundInstance(Tool);
		if AppliedSkins[Tool] then
			RemoveSkinFromTool(Tool);
		end;
		AppliedSkins[Tool] = {
			SkinName = SkinName,
			OriginalMeshId = default.MeshId,
			OriginalTextureID = default.TextureID,
			OriginalTransparency = default.Transparency,
			OriginalSkinName = Handle:GetAttribute('SkinName') or '',
			Default = default,
			ShootSound = ShootSound,
			OriginalShootSoundId = ShootSound and (ShootSoundDefaults[ShootSound] or ShootSound.SoundId) or nil,
			ShootSoundOriginals = ShootSound and { [ShootSound] = (ShootSoundDefaults[ShootSound] or ShootSound.SoundId) } or {},
			ClonedChildren = {},
			Connections = {},
			DesiredTextureID = default.TextureID,
			DesiredMeshId = default.MeshId,
			DesiredTransparency = default.Transparency,
			HideDefault = false,
		};
		Handle:SetAttribute('SkinName', SkinName);
		local attrConn = Handle:GetAttributeChangedSignal('SkinName'):Connect(function()
			if Handle:GetAttribute('SkinName') ~= SkinName then
				Handle:SetAttribute('SkinName', SkinName);
			end;
		end);
		table.insert(AppliedSkins[Tool].Connections, attrConn);
		local isKnife = Tool.Name:lower():find('knife') ~= nil or Tool.Name == '[Knife]';
		local weaponName = Tool.Name:lower():sub(2, -2);
		local skinInfo = GetSkinInfo(Tool.Name, SkinName);
		local textureOnlySkin = not isKnife and skinInfo and type(skinInfo.TextureID) == 'string' and skinInfo.TextureID ~= '';
		if not isKnife and not skinInfo then
