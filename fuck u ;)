    o.barOutline.Size=UDim2.new(0,bw+2,0,h+2)
    o.barOutline.BackgroundTransparency=(VA.HealthBar.Outline==false) and 1 or 0.35
    o.bar.Visible=true
    o.bar.Position=UDim2.new(0,1,0,(1-frac)*h+1)
    o.bar.Size=UDim2.new(0,bw,0,math.max(frac*h,1))
    o.bar.BackgroundColor3=Color3.new(1,1,1)
    o.barGrad.Enabled=true
    o.barGrad.Color=ColorSequence.new({
     ColorSequenceKeypoint.new(0,VA.HealthBar.Color1 or Color3.fromRGB(0,255,0)),
     ColorSequenceKeypoint.new(0.5,VA.HealthBar.Color2 or Color3.fromRGB(255,255,0)),
     ColorSequenceKeypoint.new(1,VA.HealthBar.Color3 or Color3.fromRGB(255,0,0)),
    })
   end)
  else
   pcall(function()
    o.barOutline.Visible=false
    o.bar.Visible=false
   end)
  end
 end
 for userId in pairs(HateEspGui) do
  if not espLabels[userId] then hateEspGuiDestroy(userId)
