function hateFhShoot(ev,pl,part)
 local FH=Config['Force Hit']
 local ch=LocalPlayer.Character
 local lroot=ch and ch:FindFirstChild('HumanoidRootPart')
 if not lroot then return false end
 local tch=pl.Character
 if not tch then return false end
 local hum=tch:FindFirstChildOfClass('Humanoid')
 if not hum or hum.Health<=0 then return false end
 if FH.KOCheck and isPlayerKnockedOrKO(pl) then return false end
 if FH.ForceFieldCheck and not FH.Prefire and tch:FindFirstChildOfClass('ForceField') then return false end
 local pos=part.Position
 if FH.UseResolver then
  local fp=resolverForcePos(pl)
  if fp then pos=fp end
 end
 if FH.UseMultipoint then
  local ok,np=pcall(aimPointFor,part,Config['Aim Assist'])
  if ok and np then pos=np end
 end
 if FH.WallCheck and not isPartVisible(part) then return false end
 local origin=lroot.Position
 if FH.OriginMode=='Strafe' and HateStrafeCF then origin=HateStrafeCF.Position elseif FH.OriginMode=='Desync' and desyncFakePos then origin=desyncFakePos end
 if (origin-pos).Magnitude>(FH.MaxDistance or 600) then return false end
 local packet=FH.Packet or 'Shoot'
 if packet=='Shoot' then
  local pellets=math.clamp(math.floor(tonumber(FH.Pellets) or 5),1,8)
  local spread=math.max(tonumber(FH.Spread) or 0,0)
  local hits={}
  local offs={}
  for i=1,pellets do
   local p=pos
   if spread>0 then
    p=pos+Vector3.new((math.random()-0.5)*spread,(math.random()-0.5)*spread,(math.random()-0.5)*spread)
   end
   hits[i]={Normal=p,Instance=part,Position=p}
   offs[i]={thePart=part,theOffset=Vector3.zero}
  end
  local args={hits,offs,origin,origin,Workspace:GetServerTimeNow()}
  local okf=pcall(function() ev:FireServer("Shoot",args) end)
  if not okf then return false end
  shotTime=tick()
  HateFhLastFire=tick()
  pcall(function() localBulletHit[pl]=tick()+1.5 end)
  return true
  elseif packet=='ShootGun' or packet=='Silent' then
   local tool=ch:FindFirstChildOfClass('Tool')
   local handle=tool and tool:FindFirstChild('Handle')
   if not handle or not handle:IsA('BasePart') then return false end
   local ammo=getToolAmmo(tool)
   if ammo and ammo.Value<=0 then return false end
   local gunOrigin=handle.Position
   local aimPos=pos
   if packet=='Silent' then
    HateFhSilentTarget={part=part,pos=aimPos,ttl=tick()+0.4}
    local okact=pcall(function() tool:Activate() end)
    shotTime=tick()
    HateFhLastFire=tick()
    HateLastSelfFire=tick()
    pcall(function() localBulletHit[pl]=tick()+1.5 end)
    return okact
   end
   local okg=pcall(function() ev:FireServer('ShootGun',handle,gunOrigin,aimPos,part,Vector3.new(0,0,-1)) end)
   if not okg then return false end
   shotTime=tick()
   HateFhLastFire=tick()
   HateLastSelfFire=tick()
   pcall(function() localBulletHit[pl]=tick()+1.5 end)
   return true
 end
 return false
end

