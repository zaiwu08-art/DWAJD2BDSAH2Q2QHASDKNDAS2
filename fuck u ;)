 if not HateDesyncMarker or not next(HateDesyncPairs) then return end
 local realCF=root.CFrame
 if desyncHold and desyncHold.cf and typeof(desyncHold.cf)=='CFrame' then realCF=desyncHold.cf end
 local fakeCF=desyncFakeCF
 if not (fakeCF and typeof(fakeCF)=='CFrame') then fakeCF=realCF end
 pcall(function() HateDesyncMarker.Parent=Workspace end)
 local okInv,delta=pcall(function() return fakeCF*root.CFrame:Inverse() end)
 if not okInv or not delta then return end
 for dp,rp in pairs(HateDesyncPairs) do
  if dp.Parent and rp and rp.Parent then
   pcall(function() dp.CFrame=delta*rp.CFrame end)
  end
 end
 local dist=(fakeCF.Position-realCF.Position).Magnitude
 local col=hateDesyncLook()
 local txt='hate.CC'
 if DS.MarkerDistance~=false then
  txt=string.format('hate.CC  |  %d studs',math.floor(dist+0.5))
 end
