 local on=VA.Enabled and (not Unloaded) and (not PanicMode) and Started
 local needFill=on and VA.Fill.Enabled and VA.Fill.Gradient
 local needBar=on and VA.HealthBar.Enabled and VA.HealthBar.Gradient
 local seen={}
 for userId,esp in pairs(espLabels) do
