local function hateAnimResolve(preset,slot)
 if not preset then return nil end
 if type(preset)=='string' and (preset:sub(1,13)=='rbxassetid://' or preset:match('^%d+$')) then return 'rbxassetid://'..(preset:match('%d+') or preset) end
 local pack=HATE_ANIM_PRESETS[preset]
 if not pack then return nil end
 local id=pack[slot]
 if not id then return nil end
 if id:sub(1,13)=='rbxassetid://' then return id end
 return 'rbxassetid://'..id
end
function hateApplyAnimChangerDirect(character)
 if not character then return false end
 local AC=Config['Animations']
 if not AC or AC.Enabled~=true then return false end
 local Animate=character:FindFirstChild('Animate')
 if not Animate then return false end
 local Humanoid=character:FindFirstChildOfClass('Humanoid')
 if not Humanoid then return false end
 local slots=AC.Animations or {}
 local applied=0
 for _,slot in ipairs(HATE_ANIM_SLOTS) do
  local preset=slots[slot]
  if preset then
   local id=hateAnimResolve(preset,slot)
   if id then
    local info=HATE_ANIM_FOLDER_MAP[slot]
    local folder=info and Animate:FindFirstChild(info.Folder)
    if folder then
     for _,cn in ipairs(info.Children) do
      local anim=folder:FindFirstChild(cn)
      if anim and anim:IsA('Animation') then anim.AnimationId=id applied=applied+1 end
     end
    end
   end
  end
 end
 if applied==0 then return false end
 for _,tr in ipairs(Humanoid:GetPlayingAnimationTracks()) do pcall(function() tr:Stop(0) end) end
 pcall(function() Animate.Disabled=true Animate.Disabled=false end)
 return true
end
