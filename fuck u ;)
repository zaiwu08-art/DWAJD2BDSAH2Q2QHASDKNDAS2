  end
  if needBar then
   local maxHp=hum.MaxHealth
   if not maxHp or maxHp<=0 then maxHp=100 end
   local targetFrac=math.clamp(hum.Health/maxHp,0,1)
   local lastFrac=o.lastFrac or targetFrac
   local frac=lastFrac+(targetFrac-lastFrac)*0.05
   o.lastFrac=frac
   local bw=math.clamp(math.floor((tonumber(VA.HealthBar.Width) or 3)+0.5),3,16)
   local barX=x-4-bw
