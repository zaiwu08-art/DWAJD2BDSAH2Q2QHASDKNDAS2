	end);

	local function ReapplySkinChangerTools()
		local function reapplyContainer(Container)
			if not Container then return end;
			for _, Tool in next, Container:GetChildren() do
				if Tool:IsA('Tool') then
					local NewSkin = GetConfiguredSkinFor(Tool);
					local CurrentSkin = AppliedSkins[Tool] and AppliedSkins[Tool].SkinName or nil;
					local needReapply = NewSkin ~= CurrentSkin;
					if not needReapply and NewSkin and IsKnifeSkin(NewSkin) and not KnifeData[Tool] then needReapply = true; end;
					if needReapply then
						ToolRegistry[Tool] = nil;
						InitialGunSkinRefreshDone[Tool] = nil;
						pcall(function() RemoveSkinFromTool(Tool) end);
						pcall(function() scxProcessTool(Tool) end);
					end;
				end;
			end;
		end;
		reapplyContainer(LocalPlayer.Character);
		reapplyContainer(LocalPlayer:FindFirstChild('Backpack'));
	end;

	local PreviousReapplyAllSkins = scxReapplyAllSkins;
	scxReapplyAllSkins = function()
		if PreviousReapplyAllSkins then PreviousReapplyAllSkins() end;
		ReapplySkinChangerTools();
	end;
SCX={Process=function(t) ToolRegistry[t]=nil; InitialGunSkinRefreshDone[t]=nil; pcall(RemoveSkinFromTool,t); pcall(scxProcessTool,t) end,Remove=function(t) ToolRegistry[t]=nil; InitialGunSkinRefreshDone[t]=nil; pcall(RemoveSkinFromTool,t) end,Reapply=function() ReapplySkinChangerTools() end,Rebind=function() for Tool in next, AppliedSkins do BindShootSoundForSkin(Tool) end end};
end;
function scApplySkin(tool,skinName)
