HateAddedAccessories={}

function hateFindAttachment(rootPart,name)
 for _,desc in ipairs(rootPart:GetDescendants()) do
  if desc:IsA("Attachment") and desc.Name==name then return desc end
 end
end

function hateWeldParts(part0,part1,c0,c1)
 local weld=Instance.new("Weld")
 weld.Part0=part0
 weld.Part1=part1
 weld.C0=c0
 weld.C1=c1 or CFrame.new()
 weld.Parent=part0
 return weld
end

function hateLoadAccessoryAsset(id)
 local ok,objs=pcall(function() return game:GetObjects("rbxassetid://"..id) end)
 if ok and objs and objs[1] then return objs[1] end
 local ok2,one=pcall(function() return InsertService:LoadLocalAsset("rbxassetid://"..id) end)
 if ok2 and one then return one end
 return nil
end

function hateAddAccessoryById(idText)
 local ch=LocalPlayer.Character
 if not ch then return false,"角色未就绪" end
 idText=tostring(idText or '')
 local id=idText:match("%d+")
 if not id then return false,"无效 ID" end
 local accessory=hateLoadAccessoryAsset(id)
 if not accessory then return false,"加载失败: "..id end
 accessory.Parent=Workspace
 local handle=accessory:FindFirstChild("Handle")
 if not handle then
  pcall(function() accessory:Destroy() end)
  return false,"资源没有 Handle"
 end
 local attachment=handle:FindFirstChildOfClass("Attachment")
 local parentPart=ch:FindFirstChild("Head") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
 if not parentPart then
  pcall(function() accessory:Destroy() end)
  return false,"找不到挂载部位"
 end
 for _,a in ipairs(HateAddedAccessories) do
  if a.Name==tostring(id) then pcall(function() a:Destroy() end) end
 end
 if attachment then
  local parentAttachment=hateFindAttachment(parentPart,attachment.Name)
  if parentAttachment then
   hateWeldParts(parentPart,handle,parentAttachment.CFrame,attachment.CFrame)
  else
   hateWeldParts(parentPart,handle,CFrame.new(0,0.5,0),CFrame.new())
  end
 else
  hateWeldParts(parentPart,handle,CFrame.new(0,0.5,0),CFrame.new())
 end
 handle.CanCollide=false
 pcall(function() accessory.Parent=ch end)
 table.insert(HateAddedAccessories,accessory)
 return true,"已添加 "..id
end

function hateRemoveAddedAccessories()
 for _,a in ipairs(HateAddedAccessories) do pcall(function() a:Destroy() end) end
 HateAddedAccessories={}
end
