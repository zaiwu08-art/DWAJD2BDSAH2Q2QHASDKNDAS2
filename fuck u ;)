  if not player or not player.Parent then hateEspGuiDestroy(userId) continue end
  if not needFill and not needBar then hateEspGuiHide(userId) continue end
  local x,y,w,h=esp.rectX,esp.rectY,esp.rectW,esp.rectH
  local hum=esp.rectHum
  if not x or not hum or not hum.Parent then hateEspGuiHide(userId) continue end
  seen[userId]=true
  local o=hateEspGuiFor(userId)
  if needFill then
   local trans=VA.Fill.Transparency or 0.8
   pcall(function()
    o.fill.Visible=true
    o.fill.Position=UDim2.new(0,x,0,y)
    o.fill.Size=UDim2.new(0,w,0,h)
    o.fill.BackgroundTransparency=math.clamp(trans,0,1)
    o.fill.BackgroundColor3=Color3.new(1,1,1)
    o.fillGrad.Enabled=true
    o.fillGrad.Color=ColorSequence.new({
     ColorSequenceKeypoint.new(0,VA.Fill.StartColor or Color3.fromRGB(255,255,255)),
     ColorSequenceKeypoint.new(1,VA.Fill.EndColor or Color3.fromRGB(0,0,0)),
    })
