local function deepCopyTable(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return seen[value] end
    local out = {}
    seen[value] = out
    for k, v in pairs(value) do
        out[deepCopyTable(k, seen)] = deepCopyTable(v, seen)
    end
    return out
end

