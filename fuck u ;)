 if HateDesyncEdgeLabel then pcall(function() HateDesyncEdgeLabel.Visible=false end) end
 if HateDesyncBeamP then pcall(function() HateDesyncBeamP.Parent=nil end) end
 if DS.SelfESP~=false then
  local se=hateSelfESPEnsure()
  if se then
   local sp=Camera:WorldToViewportPoint(fakeCF.Position+Vector3.new(0,3.2,0))
   local sf=Camera:WorldToViewportPoint(fakeCF.Position-Vector3.new(0,3.8,0))
   local hh=math.abs(sf.Y-sp.Y)
   if hh>4 and hh<5000 then
    local ww=hh*0.62
    se.box.Size=Vector2.new(ww,hh);se.box.Position=Vector2.new(sp.X-ww/2,sp.Y);se.box.Color=col;se.box.Visible=true
    se.outline.Size=Vector2.new(ww+2,hh+2);se.outline.Position=Vector2.new(sp.X-ww/2-1,sp.Y-1);se.outline.Visible=true
    se.txt.Text=txt;se.txt.Color=col;se.txt.Position=Vector2.new(sp.X,sp.Y-16);se.txt.Visible=true
   else hateSelfESPHide() end
  end
 else hateSelfESPHide() end
end
