function desyncCompute(DS,oldPos,dt)
 local m=DS.Mode
 if m=='Underground' then
  return oldPos-Vector3.new(0,12+(DS.Depth or 0),0)
 elseif m=='Void' then
  local r=math.max(math.floor(DS.HOffset or 60),10)
  return oldPos+Vector3.new(math.random(-r,r),math.random(-r,r),math.random(-r,r))
 elseif m=='Spam Void' then
  local vt=math.max(tonumber(DS.VoidTime) or 0.4,0.01)
  local gt=math.max(tonumber(DS.GroundTime) or 0.133,0.01)
  desyncPhase=desyncPhase+(dt or 0)
  if desyncPhase>=vt+gt then desyncPhase=0 end
  if desyncPhase<vt then
   return oldPos+Vector3.new(math.random(-9e8,9e8),math.random(1e8,9e8),math.random(-9e8,9e8))
  end
  return nil
 elseif m=='Chaos' then
  local t=tick()*999
  return oldPos+Vector3.new(math.sin(t)*9e8,math.abs(math.cos(t*1.3))*9e8,math.sin(t*0.7)*9e8)
 elseif m=='Epilepsy' then
  local flip=math.floor(tick()*60)%2==0
  local s=9e8
  if flip then return oldPos+Vector3.new(s,s,s) end
  return oldPos-Vector3.new(s,s,s)
 elseif m=='Custom' then
  return oldPos+Vector3.new(tonumber(DS.CustomX) or 0,tonumber(DS.CustomY) or 0,tonumber(DS.CustomZ) or 0)
 end
 return nil
end

