 return false
end
function smIsShooting()
 return tick()-shotTime<0.35
end
function smMovementKey(char,hum,cfgTbl)
 local tool=char and char:FindFirstChildOfClass('Tool')
 local isKnife=smIsKnifeTool(tool)
 local isReload=smIsReloading(char,tool)
 local thr=tonumber(cfgTbl.LowHealthThreshold) or 25
 local isLow=hum~=nil and hum.Health>0 and hum.Health<=thr
 local desired='Normal'
 if isKnife then desired='Knife'
 elseif isLow then desired='Low Health'
 elseif isReload then desired='Reload'
 elseif smIsShooting() then desired='Shooting' end
 local cond=cfgTbl.Conditions or {}
 local entry=cond[desired]
 if entry and entry.Enabled==false then return 'Normal' end
 return desired
end
function smMultiplier(cfgTbl,key)
 local entry=(cfgTbl.Conditions or {})[key]
 if not entry then return 1 end
 if entry.Enabled==false then return 1 end
 return tonumber(entry.Multiplier) or 1
end
function smBaseValue(cfgTbl,default)
 local mult=tonumber(cfgTbl.Multiplier) or default
 if cfgTbl.Mode=='Multiplier' then return mult*100 end
 return tonumber(cfgTbl.Number) or default
end
