	function scxProcessTool(Tool)
		if ToolRegistry[Tool] then return end;
		for _, snd in next, Tool:GetDescendants() do
			if snd:IsA('Sound') and (snd.Name == 'Shoot' or snd.Name == 'ShootSound') then
				if ShootSoundDefaults[snd] == nil then ShootSoundDefaults[snd] = snd.SoundId; end;
			end;
		end;
		ToolRegistry[Tool] = true;
		local ConfiguredSkin = GetConfiguredSkinFor(Tool);
		if not ConfiguredSkin then return end;
		local isKnife = Tool.Name:lower():find('knife') ~= nil or Tool.Name == '[Knife]';
		if isKnife and IsKnifeSkin(ConfiguredSkin) then
			ApplySkinToTool(Tool, ConfiguredSkin);
			local equipConn;
			equipConn = Tool.Equipped:Connect(function()
				if not AppliedSkins[Tool] then
					if equipConn then equipConn:Disconnect() end;
					return;
				end;
				local char = Tool.Parent;
				if char ~= LocalPlayer.Character then return end;
				local live = GetConfiguredSkinFor(Tool);
				if live and IsKnifeSkin(live) then
					ApplyKnife(char, Tool, live);
				else
					CleanKnife(Tool);
				end;
			end);
			if not AppliedSkins[Tool].Connections then
				AppliedSkins[Tool].Connections = {};
			end;
			table.insert(AppliedSkins[Tool].Connections, equipConn);
			if LocalPlayer.Character and Tool.Parent == LocalPlayer.Character then
				ApplyKnife(LocalPlayer.Character, Tool, ConfiguredSkin);
			end;
			BindKnifeAttack(Tool);
		else
			ApplySkinToTool(Tool, ConfiguredSkin);
			Tool.Equipped:Connect(function()
				local char = Tool.Parent;
				if char ~= LocalPlayer.Character then return end;
				local live = GetConfiguredSkinFor(Tool) or ConfiguredSkin;
				ApplySkinToTool(Tool, live);
				if isKnife then PlayKnifeEquip(Tool) end;
			end);
			if LocalPlayer.Character and Tool.Parent == LocalPlayer.Character then
				ApplySkinToTool(Tool, ConfiguredSkin);
				if isKnife then PlayKnifeEquip(Tool) end;
			end;
			if isKnife then BindKnifeAttack(Tool) end;
		end;
	end;

	function scxProcessCharacter(Character)
		if not Character then return end;
		for _, Child in next, Character:GetChildren() do
