end
function scSkinList(toolName)
 local out={}
 local seen={}
 local function add(nm)
  if type(nm)~='string' or nm=='' then return end
  if seen[nm] then return end
  seen[nm]=true
  out[#out+1]=nm
 end
 local data=scLoadData()
 local key=scWeaponKey(toolName)
 local function fromTable(t)
  if type(t)~='table' then return end
  for k,_ in pairs(t) do if type(k)=='string' then add(k) end end
 end
 if data then
  fromTable(data[toolName])
  fromTable(data[key])
  fromTable(data['['..key..']'])
  fromTable(data[string.upper(key)])
  if scIsKnifeName(toolName) then
   fromTable(data['Knife'])
   fromTable(data['[Knife]'])
   fromTable(data['knife'])
   fromTable(data['Knives'])
  end
 end
 local m=scFindModules()
 if m then
  if scIsKnifeName(toolName) then
   local kf=m:FindFirstChild('Knives') or m:FindFirstChild('Knife')
   if kf then for _,c in ipairs(kf:GetChildren()) do add(c.Name) end end
  else
   local wn=scWeaponMeshKey(toolName)
   local matched={}
   local all={}
   local mf=m:FindFirstChild('Meshes') or m:FindFirstChild('GunModels')
   if mf then
    for _,c in ipairs(mf:GetChildren()) do
     all[#all+1]=c.Name
     if wn=='' then
      matched[#matched+1]=c.Name
     elseif c:IsA('BasePart') then
      local lp=string.lower(tostring(c.Name))
      if lp==wn or string.find(lp,wn,1,true) then matched[#matched+1]=c.Name end
     else
      for _,p in ipairs(c:GetChildren()) do
       local lp=string.lower(tostring(p.Name))
       if lp==wn or (wn~='' and string.find(lp,wn,1,true)) then matched[#matched+1]=c.Name break end
      end
     end
    end
   end
   local use=(#matched>0) and matched or all
   for _,nm in ipairs(use) do add(nm) end
  end
 end
 table.sort(out,function(a,b) return a:lower()<b:lower() end)
 return out
end
function scWeaponMeshKey(toolName)
 local n=string.lower(tostring(toolName))
 if n:sub(1,1)=='[' then n=n:sub(2) end
 if n:sub(-1)==']' then n=n:sub(1,-2) end
 return n
end
