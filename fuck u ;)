HatePosCache={};HatePosLast=0;HateNetState={ping=0,jitter=0,last=0}
function hateUpdateMotionCache()
 local now=os.clock()
 if now-HatePosLast<0.03 then return end
 HatePosLast=now
 for _,pl in ipairs(Players:GetPlayers()) do
  if pl~=LocalPlayer and pl.Character then
   local root=pl.Character:FindFirstChild('HumanoidRootPart')
   if root then
    local c=HatePosCache[pl]
    if not c then c={} HatePosCache[pl]=c end
    local lastC=c[1]
    if not lastC or (now-lastC.t)>=0.029 then
     table.insert(c,1,{p=root.Position,t=now})
     if #c>24 then c[#c]=nil end
    end
   end
  end
 end
 for pl in pairs(HatePosCache) do
  if not pl or not pl.Parent then HatePosCache[pl]=nil end
 end
end
function hateSmoothedMotion(pl)
 local Z=Vector3.new(0,0,0)
 local c=pl and HatePosCache[pl]
 if not c or #c<2 then return Z,Z end
 local dt=c[1].t-c[math.min(#c,4)].t
 if dt<=0.001 then return Z,Z end
 local vel=(c[1].p-c[math.min(#c,4)].p)/dt
 local acc=Z
 if #c>=4 then
  local rt=c[1].t-c[2].t
  local ot=c[3].t-c[4].t
  local bt=((c[1].t+c[2].t)-(c[3].t+c[4].t))*0.5
  if rt>0.001 and ot>0.001 and bt>0.001 then
   acc=((c[1].p-c[2].p)/rt-(c[3].p-c[4].p)/ot)/bt
  end
 end
 if vel.Magnitude>350 then vel=Z end
 if acc.Magnitude>1500 then acc=Z end
 return vel,acc
end
function hateBacktrackPick(pl,fallback)
 local c=pl and HatePosCache[pl]
 if not c or #c<2 then return fallback end
 local ns=HateNetState or {}
 local ping=(ns.ping or 0)
 local targetT=os.clock()-math.clamp(ping,0.02,0.5)
 local best=nil;local bd=1e9
 for _,s in ipairs(c) do
  local dd=math.abs(s.t-targetT)
  if dd<bd then bd=dd;best=s end
 end
 if best and bd<0.25 then return best.p end
 return fallback
end
function hateNetworkLead()
 local now=os.clock()
 if now-HateNetState.last>=0.1 then
  HateNetState.last=now
  local ping=(serverPing() or 0)/1000
  if ping>0 then
   local a=0.15
   if HateNetState.ping<=0 then HateNetState.ping=ping;HateNetState.jitter=0
   else
    HateNetState.jitter=HateNetState.jitter+(math.abs(ping-HateNetState.ping)-HateNetState.jitter)*a
    HateNetState.ping=HateNetState.ping+(ping-HateNetState.ping)*a
   end
  end
 end
 return HateNetState
end
function hatePredictAim(pl,pos,toolName)
 local ST=Config['Sticky']
 if not ST then return pos end
 if not (ST.MotionPredict~=false) then return pos end
 local vel,acc=hateSmoothedMotion(pl)
 if vel.Magnitude<2 and acc.Magnitude<2 then return pos end
 local x=tonumber(ST.PredX) or 0.023
 local y=tonumber(ST.PredY) or 0.08
 local z=tonumber(ST.PredZ) or 0.013
 if ST.AutoLead~=false then
  local ns=hateNetworkLead()
  local cls=ssWeaponClass(toolName or '')
  local base=(cls=='Shotguns') and 0.018 or ((cls=='Pistols') and 0.023 or 0.013)
  local off=(ns.ping or 0)*0.5+0.01+(ns.jitter or 0)*0.5
  x=math.clamp(base+off,0.01,0.2)
  y=x z=x
 end
 local out=pos+vel*Vector3.new(x,y,z)
 if ST.AutoLead~=false then
  out=out+Vector3.new(acc.X*x*x*0.5,acc.Y*y*y*0.5,acc.Z*z*z*0.5)
 end
 return out
end
function ssWeaponClass(name)
 if SShotgunNames[name] then return 'Shotguns' end
 if SSpistolNames[name] then return 'Pistols' end
 return 'Others'
end
