function hateStrafeTick(dt)
 local FH=Config['Force Hit']
 if not (FH.Enabled and FH.Strafe) or Unloaded or PanicMode or not Started then
  HateStrafeCF=nil
  hateStrafeRestore()
  hateStrafeVisClear()
  return
 end
 local pl,part=hateFhTarget()
 if not pl or not part then HateStrafeCF=nil hateStrafeRestore() return end
 local ch=LocalPlayer.Character
 local root=ch and ch:FindFirstChild('HumanoidRootPart')
 if not root then return end
 HateStrafeTime=HateStrafeTime+(dt or 0)
 local targetPos=part.Position
 local speed=tonumber(FH.StrafeSpeed) or 5
 local sdist=tonumber(FH.StrafeDistance) or 5
 local sheight=tonumber(FH.StrafeHeight) or 0
 local mode=FH.StrafeMode or 'Orbit'
 local desired
 if mode=='Orbit' then
  local ang=HateStrafeTime*speed
  desired=CFrame.lookAt(targetPos+Vector3.new(math.cos(ang)*sdist,sheight,math.sin(ang)*sdist),targetPos)
 elseif mode=='Random' then
  local t=HateStrafeTime*40
  local off=Vector3.new(math.noise(t,0,0)*20,math.noise(0,t,0)*15+sheight,math.noise(0,0,t)*20)
  desired=CFrame.lookAt(targetPos+off,targetPos)
 elseif mode=='Void Shoot' then
  HateStrafePhase=HateStrafePhase+(dt or 0)
  local shooting=(tick()-HateFhLastFire)<0.12
  if shooting then
   HateStrafePhase=0
   HateStrafeVoid=false
   desired=CFrame.lookAt(targetPos+Vector3.new(0,200,2),targetPos)
  else
   local vt=math.max(tonumber(FH.StrafeVoidTime) or 0.4,0.01)
   local gt=math.max(tonumber(FH.StrafeGroundTime) or 0.133,0.01)
   if not HateStrafeVoid then
    if HateStrafePhase>=gt then HateStrafeVoid=true HateStrafePhase=0 end
    desired=CFrame.lookAt(targetPos+Vector3.new(0,3,2),targetPos)
   else
    if HateStrafePhase>=vt then HateStrafeVoid=false HateStrafePhase=0 end
    desired=CFrame.new(targetPos+Vector3.new(0,10000,0))
   end
  end
 end
 if not desired then return end
 HateStrafeCF=desired
 if FH.StrafeVisualize then
  if not HateStrafeVisParts then hateStrafeVisBuild(ch,root) end
 else
  hateStrafeVisClear()
 end
 if FH.StrafeSpoof then
  local old=root.CFrame
  local oldVel=root.AssemblyLinearVelocity
  if typeof(oldVel)~="Vector3" then oldVel=root.Velocity or Vector3.new() end
  if not HateStrafeCam then
   local setback=Workspace:FindFirstChild('HateStrafeSetback')
   if not setback then
    setback=Instance.new("Part")
    setback.Name="HateStrafeSetback"
    setback.Size=Vector3.new(2,2,1)
    setback.Transparency=1
    setback.CanCollide=false
    setback.Anchored=true
    setback.Parent=Workspace
   end
   setback.CFrame=old+Vector3.new(0,5,0)
   pcall(function() Camera.CameraSubject=setback end)
   HateStrafeCam=setback
  end
  HateStrafeHold={hrp=root,cf=old,vel=oldVel}
  pcall(function() root.CFrame=desired end)
 else
  hateStrafeRestore()
  pcall(function() root.CFrame=desired end)
  if FH.SpectateTarget then
   local tch=pl.Character
   local subj=tch and (tch:FindFirstChild('Head') or tch:FindFirstChildOfClass('Humanoid'))
   if subj then pcall(function() Camera.CameraSubject=subj end) HateStrafeCam=subj end
  else
   hateStrafeRestoreCamera()
  end
 end
end

